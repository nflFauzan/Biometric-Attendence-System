# Salin menjadi .env lalu isi nilainya. File .env tidak boleh di-commit.
DB_NAME=absensi
DB_USERNAME=absensi
DB_PASSWORD=ganti-dengan-password-kuat
DB_PORT=5432
WEB_PORT=3000

# Akun Owner pertama, dibuat otomatis saat backend pertama kali jalan (jika belum ada Owner).
# Owner wajib mengganti password ini saat login pertama.
OWNER_USERNAME=owner
OWNER_INITIAL_PASSWORD=ganti-saat-login-pertama

# Cookie sesi hanya dikirim lewat HTTPS. Wajib true di production; false untuk development (http://localhost).
SESSION_COOKIE_SECURE=false

# Dokumentasi API (Swagger UI di /swagger-ui/index.html, JSON di /v3/api-docs).
# Biarkan false di production. Saat true tetap wajib login sebagai Owner atau HR/Finance.
OPENAPI_ENABLED=false
